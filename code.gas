const APP_PASS = "passwd";

function doGet(e) {
  const p = e.parameter.p;
  const user = e.parameter.u;
  if (p !== APP_PASS || !user) return ContentService.createTextOutput("Forbidden");

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(user);
  
  const data = {};
  
  // 勤怠データの取得
  if (sheet) {
    const values = sheet.getDataRange().getDisplayValues(); 
    
    for (let i = 1; i < values.length; i++) {
      const row = values[i];
      if (!row[0]) continue;
      
      let dateKey = row[0].trim();
      if (dateKey.includes('/')) dateKey = dateKey.replace(/\//g, '-'); 

      const vacationType = row[4] || ""; // E列：休暇種別
      
      // 休暇判定
      const isAbsent = isVacationDay(vacationType);
      const isHalfDay = isHalfDayVacation(vacationType);
      
      // 祝日情報取得
      const holidayInfo = getHolidayInfo(dateKey);
      
      data[dateKey] = { 
        place: row[1] || "", 
        start: row[2] || "", 
        end: row[3] || "", 
        vacationType: vacationType,
        isAbsent: isAbsent,
        isHalfDay: isHalfDay,
        isHoliday: holidayInfo.isHoliday,
        holidayName: holidayInfo.holidayName,
        absenceReason: vacationType
      };
    }
  }
  
  // 表示中の年の祝日情報を全て追加（勤怠データがない日も含む）
  const year = e.parameter.year ? parseInt(e.parameter.year) : new Date().getFullYear();
  const holidays = getHolidays(year);
  
  for (const dateKey in holidays) {
    if (!data[dateKey]) {
      // 勤怠データがない日の祝日情報を追加
      data[dateKey] = {
        place: "",
        start: "",
        end: "",
        vacationType: "",
        isAbsent: false,
        isHalfDay: false,
        isHoliday: true,
        holidayName: holidays[dateKey],
        absenceReason: ""
      };
    } else {
      // 勤怠データがある日にも祝日情報を追加
      data[dateKey].isHoliday = true;
      data[dateKey].holidayName = holidays[dateKey];
    }
  }
  
  return ContentService.createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}

// 全日休暇判定関数
function isVacationDay(vacationType) {
  const vacationTypes = [
    "有給休暇", "特別休暇", "病気休暇", "慶弔休暇", 
    "その他休暇", "欠勤"
  ];
  return vacationTypes.includes(vacationType);
}

// 半休判定関数
function isHalfDayVacation(vacationType) {
  return vacationType === "午前半休" || vacationType === "午後半休";
}

// 祝日情報取得関数（名前も返す）
function getHolidayInfo(dateStr) {
  const date = new Date(dateStr);
  if (isNaN(date.getTime())) return { isHoliday: false, holidayName: "" };
  
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  const key = `${year}-${month}-${day}`;
  
  const holidays = getHolidays(year);
  const holidayName = holidays[key] || "";
  
  return {
    isHoliday: !!holidayName,
    holidayName: holidayName
  };
}

// 祝日データ取得関数（キャッシュ付き）
function getHolidays(year) {
  const cache = CacheService.getScriptCache();
  const cacheKey = `holidays_${year}`;
  
  const cached = cache.get(cacheKey);
  if (cached) {
    return JSON.parse(cached);
  }
  
  try {
    const url = `https://holidays-jp.github.io/api/v1/${year}/date.json`;
    const response = UrlFetchApp.fetch(url);
    const holidays = JSON.parse(response.getContentText());
    
    cache.put(cacheKey, JSON.stringify(holidays), 24 * 3600);
    
    return holidays;
  } catch (e) {
    console.error('祝日データ取得失敗:', e);
    return {};
  }
}

function doPost(e) {
  try {
    const postData = JSON.parse(e.postData.contents);
    if (postData.password !== APP_PASS) return;

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let sheet = ss.getSheetByName(postData.user);
    
    // 新規シート作成時は新しい構造で作成
    if (!sheet) {
      sheet = ss.insertSheet(postData.user);
      sheet.appendRow(["日付", "場所", "開始", "終了", "休暇種別"]);
    }

    const values = sheet.getDataRange().getDisplayValues();
    const targetDate = postData.date;
    let rowIndex = -1;

    for (let i = 1; i < values.length; i++) {
      let sDate = values[i][0].replace(/\//g, '-').trim();
      if (sDate === targetDate) { rowIndex = i + 1; break; }
    }

    if (postData.isDelete) {
      // 勤怠データを削除（行を削除）
      if (rowIndex !== -1) {
        sheet.deleteRow(rowIndex);
      }
      // 注意: 祝日情報はdoGetで自動的に追加されるため、削除後も表示される
    } else {
      // 休暇種別の決定
      let vacationType = "";
      
      if (postData.isAbsent) {
        // 欠勤・休暇の場合、placeに理由が入っている（空の場合もそのまま保存）
        vacationType = postData.place || "";
      } else if (postData.isHalfDay) {
        // 半休の場合
        if (postData.halfDayType === "morning") {
          vacationType = "午前半休";
        } else if (postData.halfDayType === "afternoon") {
          vacationType = "午後半休";
        } else {
          // 時間から推測
          const start = postData.start || "";
          const end = postData.end || "";
          if (start.includes("9:00") && end.includes("12:00")) {
            vacationType = "午前半休";
          } else if (start.includes("13:00") && end.includes("18:00")) {
            vacationType = "午後半休";
          } else {
            vacationType = "午前半休"; // デフォルト
          }
        }
      }
      
      const newRow = [
        targetDate, 
        postData.isAbsent ? "" : (postData.place || ""),
        postData.start || "", 
        postData.end || "", 
        vacationType
      ];
      
      if (rowIndex !== -1) {
        sheet.getRange(rowIndex, 1, 1, 5).setValues([newRow]);
      } else {
        sheet.appendRow(newRow);
        if (sheet.getLastRow() > 1) {
          sheet.getRange(2, 1, sheet.getLastRow() - 1, 5).sort({column: 1, ascending: true});
        }
      }
    }
    
    return ContentService.createTextOutput("ok");
  } catch(err) {
    console.error(err.toString());
    return ContentService.createTextOutput("");
  }
}